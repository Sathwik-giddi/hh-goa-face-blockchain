# $0 — all free tiers, no card
# Search: free 250/mo at serpapi.com/users/sign_up (email only)
SERPAPI_API_KEY=
SEARCH_MODE=live
# live = real SerpAPI Lens, mock = wiring demo if no key yet

# Blockchain: local = $0 hash-chain (default, spec-allowed). evm = Polygon Amoy free faucet
BLOCKCHAIN_MODE=local
CHAIN_FILE=./chain.json
EVM_RPC_URL=https://rpc-amoy.polygon.technology
EVM_PRIVATE_KEY=
EVM_CONTRACT_ADDRESS=
EVM_CHAIN_ID=80002

# Face
FACE_DETECTOR=opencv
