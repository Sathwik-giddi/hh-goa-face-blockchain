# $0 — all free tiers, no card. LIVE ONLY, no mock fallback.
# Search: free 250/mo at serpapi.com/users/sign_up (email only)
SERPAPI_API_KEY=
# Search mode: live only (no mock fallback by design)
SEARCH_MODE=live

# Blockchain: local = $0 hash-chain (spec-allowed). evm = Polygon Amoy free faucet
BLOCKCHAIN_MODE=evm
CHAIN_FILE=./chain.json
# EVM (only used when BLOCKCHAIN_MODE=evm)
EVM_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
EVM_PRIVATE_KEY=
# Mirror for cross-machine EVM verify (auto-managed)
EVM_MIRROR_FILE=./evm_mirror.json
EVM_CONTRACT_ADDRESS=
EVM_CHAIN_ID=80002

# Face detector
FACE_DETECTOR=opencv

# API CORS (comma-separated). Default is local dev only.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
